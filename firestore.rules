rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRepoData(data) {
      return data.keys().hasAll(['ownerId', 'tree'])
          && data.keys().size() == 2
          && data.ownerId is string
          && data.tree is string
          && data.tree.size() <= 1048576
          && data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /repos/{repoId} {
      allow read: if isSignedIn() && isValidId(repoId) && (resource == null || existing().ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(repoId) && isValidRepoData(incoming());
      
      allow update: if (
        isSignedIn() && isValidId(repoId) && existing().ownerId == request.auth.uid &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['tree', 'ownerId']) &&
          incoming().tree is string &&
          incoming().tree.size() <= 1048576 &&
          incoming().ownerId == existing().ownerId
        )
      );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid && isValidId(repoId);
    }
  }
}
